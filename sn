#!/usr/bin/env python3

import sys
import socket
import struct
from datetime import datetime, timedelta
from xml.sax.saxutils import escape

import xmltodict
import ms.netkrb


# ============================================================
# CONFIGURATION
# ============================================================

DATE_FORMAT = "%Y-%m-%d"
BUFFSIZE = 4096

SOAP_HOST = "sln0-prod"

# IMPORTANT:
# Replace this with the exact port used by the working push_py
SOAP_PORT = YOUR_EXISTING_PORT


# ============================================================
# INPUT
# ============================================================

def get_inputs():

    print()
    print("=" * 70)
    print("ServiceNow Incident Search")
    print("=" * 70)

    group = input(
        "Assignment group                  : "
    ).strip()

    keyword = input(
        "Short description contains [Regal Asia]: "
    ).strip()

    if not keyword:
        keyword = "Regal Asia"

    date_from = input(
        "Created FROM date [YYYY-MM-DD]     : "
    ).strip()

    date_till = input(
        "Created TILL date [YYYY-MM-DD]     : "
    ).strip()

    if not group:
        raise ValueError(
            "Assignment group cannot be empty."
        )

    return group, keyword, date_from, date_till


# ============================================================
# DATE VALIDATION
# ============================================================

def validate_dates(date_from, date_till):

    try:
        start = datetime.strptime(
            date_from,
            DATE_FORMAT
        )

        end = datetime.strptime(
            date_till,
            DATE_FORMAT
        )

    except ValueError:
        raise ValueError(
            "Dates must be in YYYY-MM-DD format."
        )

    if start > end:
        raise ValueError(
            "FROM date cannot be later than TILL date."
        )

    return start, end


# ============================================================
# SERVICENOW ENCODED QUERY
# ============================================================

def build_encoded_query(group, keyword, start, end):

    start_timestamp = start.strftime(
        "%Y-%m-%d 00:00:00"
    )

    # Make TILL date inclusive.
    # Example:
    #
    # FROM = 2026-09-01
    # TILL = 2026-10-02
    #
    # query becomes:
    #
    # >= 2026-09-01 00:00:00
    # <  2026-10-03 00:00:00

    end_timestamp = (
        end + timedelta(days=1)
    ).strftime(
        "%Y-%m-%d 00:00:00"
    )

    query = (
        f"assignment_group={group}"
        f"^short_descriptionLIKE{keyword}"
        f"^sys_created_on>={start_timestamp}"
        f"^sys_created_on<{end_timestamp}"
    )

    return query


# ============================================================
# SOAP BODY
# ============================================================

def build_soap_body(encoded_query):

    safe_query = escape(encoded_query)

    return f"""
<SOAP-Env:Body>
    <getRecords xmlns="http://www.service-now.com/ticket">
        <__use_view>API</__use_view>
        <__encoded_query>{safe_query}</__encoded_query>
    </getRecords>
</SOAP-Env:Body>
""".strip()


# ============================================================
# SOAP ENVELOPE
# ============================================================

def build_soap_request(encoded_query):

    body = build_soap_body(encoded_query)

    return f"""<?xml version="1.0" encoding="UTF-8"?>
<SOAP-Env:Envelope
    xmlns:SOAP-Env="http://schemas.xmlsoap.org/soap/envelope/">

{body}

</SOAP-Env:Envelope>
"""


# ============================================================
# INTERNAL TCP TRANSPORT
# ============================================================

class TCPError(Exception):
    pass


class TCP:

    def __init__(
        self,
        hostname,
        port,
        timeout=None,
        kerberos=False,
        anonymous=False
    ):

        self.hostname = hostname
        self.port = port
        self.timeout = timeout
        self.kerberos = kerberos
        self.anonymous = anonymous
        self.connected = False

        self.sock = socket.socket(
            socket.AF_INET,
            socket.SOCK_STREAM
        )

        if timeout is not None:
            self.sock.settimeout(timeout)


    def connect(self):

        self.sock.connect(
            (
                self.hostname,
                self.port
            )
        )

        if self.kerberos or self.anonymous:
            self.authenticate(
                self.kerberos,
                self.anonymous
            )

        self.connected = True


    def authenticate(
        self,
        kerberos,
        anonymous
    ):

        mechlist = []

        if kerberos:
            mechlist.append("Kerberos")

        if anonymous:
            mechlist.append("Anonymous")

        ms.netkrb.NetKrb.authenticate_client(
            sock=self.sock,
            role="Client",
            mechlist=mechlist
        )


    def sendrequest(self, data):

        self.sendmessage(data)

        return self.receivemessage()


    def sendmessage(self, data):

        if not self.connected:
            raise TCPError(
                "TCP connection is not established."
            )

        length = len(data)

        # Existing protocol:
        # first 4 bytes contain message length
        data = struct.pack(
            ">I",
            length
        ) + data

        sent = 0

        while sent < len(data):

            count = self.sock.send(
                data[
                    sent:
                    sent + BUFFSIZE
                ]
            )

            if count == 0:
                raise TCPError(
                    "TCP connection closed while sending."
                )

            sent += count


    def receivemessage(self):

        result = ""

        while True:

            hdr = self._recv_exact(4)

            if len(hdr) != 4:
                raise TCPError(
                    "Server has not returned SOAP reply."
                )

            size = struct.unpack(
                ">I",
                hdr
            )[0]

            # High bit indicates another message follows.
            need_to_continue = (
                size > 2147483648
            )

            if need_to_continue:
                size -= 2147483648

            data = self._recv_exact(size)

            result += data.decode(
                "utf-8",
                errors="replace"
            )

            if not need_to_continue:
                break

        return result


    def _recv_exact(self, size):

        chunks = []
        received = 0

        while received < size:

            chunk = self.sock.recv(
                min(
                    BUFFSIZE,
                    size - received
                )
            )

            if not chunk:
                raise TCPError(
                    "Connection closed while receiving data."
                )

            chunks.append(chunk)
            received += len(chunk)

        return b"".join(chunks)


    def close(self):

        try:
            self.sock.close()
        finally:
            self.connected = False


# ============================================================
# SEND SOAP
# ============================================================

def send_soap_request(soap_request):

    client = TCP(
        hostname=SOAP_HOST,
        port=SOAP_PORT,
        kerberos=True
    )

    try:

        print()
        print(
            f"Connecting to {SOAP_HOST}:{SOAP_PORT} ..."
        )

        client.connect()

        print("Connected.")
        print("Sending ServiceNow SOAP request...")

        response = client.sendrequest(
            soap_request.encode("utf-8")
        )

        return response

    finally:

        client.close()


# ============================================================
# PARSE SERVICENOW RESPONSE
# ============================================================

def parse_incidents(response, keyword):

    data = xmltodict.parse(response)

    envelope = (
        data.get("soap:Envelope")
        or data.get("SOAP-Env:Envelope")
        or {}
    )

    body = (
        envelope.get("soap:Body")
        or envelope.get("SOAP-Env:Body")
        or {}
    )

    response_data = (
        body.get("getRecordsResponse")
        or {}
    )

    records = response_data.get(
        "getRecordsResult",
        []
    )

    if not records:
        return []

    # ServiceNow may return a dict when there is only
    # one incident and a list when there are many.
    if isinstance(records, dict):
        records = [records]

    incidents = []

    keyword_lower = keyword.lower()

    for record in records:

        short_description = (
            record.get("short_description")
            or ""
        )

        # Explicit case-insensitive verification.
        if keyword_lower not in short_description.lower():
            continue

        incidents.append(
            {
                "number":
                    record.get("number", ""),

                "short_description":
                    short_description,

                "created":
                    record.get(
                        "sys_created_on",
                        ""
                    ),
            }
        )

    return incidents


# ============================================================
# DISPLAY
# ============================================================

def display_incidents(incidents):

    print()
    print("=" * 110)

    print(
        f"{'Incident':<18}"
        f"{'Created':<22}"
        f"{'Short Description'}"
    )

    print("=" * 110)

    if not incidents:

        print("No matching incidents found.")

        print("=" * 110)
        return

    for incident in incidents:

        print(
            f"{incident['number']:<18}"
            f"{incident['created']:<22}"
            f"{incident['short_description']}"
        )

    print("=" * 110)

    print(
        f"Total incidents: {len(incidents)}"
    )


# ============================================================
# MAIN
# ============================================================

def main():

    try:

        group, keyword, date_from, date_till = (
            get_inputs()
        )

        start, end = validate_dates(
            date_from,
            date_till
        )

        encoded_query = build_encoded_query(
            group,
            keyword,
            start,
            end
        )

        print()
        print("Encoded query:")
        print(encoded_query)

        soap_request = build_soap_request(
            encoded_query
        )

        response = send_soap_request(
            soap_request
        )

        incidents = parse_incidents(
            response,
            keyword
        )

        display_incidents(
            incidents
        )

    except KeyboardInterrupt:

        print("\nCancelled.")
        sys.exit(130)

    except Exception as error:

        print()
        print("ERROR:")
        print(error)

        sys.exit(1)


if __name__ == "__main__":
    main()
