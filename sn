#!/usr/bin/env python3

"""
ServiceNow Incident Query
Python 3.10+

Search criteria:
    1. Assignment group
    2. Short description contains a phrase
    3. Incident creation date >= FROM date
    4. Incident creation date <= TILL date

Output:
    Incident Number
    Created Date/Time
    Short Description

The SOAP query format follows the internal ServiceNow SOAP
examples supplied with this project.
"""

import sys
from datetime import datetime, timedelta
from xml.sax.saxutils import escape

import xmltodict

# Internal package provided by:
# morganstanley-python-soap
import ms.soap.envelope as envelope


DATE_FORMAT = "%Y-%m-%d"


# ============================================================
# USER INPUT
# ============================================================

def get_inputs():

    print()
    print("=" * 70)
    print(" ServiceNow Incident Search")
    print("=" * 70)

    group = input(
        "Assignment group               : "
    ).strip()

    keyword = input(
        "Short description contains     [Reg Asia]: "
    ).strip()

    if not keyword:
        keyword = "Reg Asia"

    date_from = input(
        "Created FROM date [YYYY-MM-DD]  : "
    ).strip()

    date_till = input(
        "Created TILL date [YYYY-MM-DD]  : "
    ).strip()

    if not group:
        raise ValueError(
            "Assignment group cannot be empty."
        )

    if not keyword:
        raise ValueError(
            "Short-description keyword cannot be empty."
        )

    return group, keyword, date_from, date_till


# ============================================================
# DATE VALIDATION
# ============================================================

def validate_dates(date_from, date_till):

    try:
        start = datetime.strptime(
            date_from,
            DATE_FORMAT
        )

    except ValueError:
        raise ValueError(
            f"Invalid FROM date '{date_from}'. "
            "Use YYYY-MM-DD."
        )

    try:
        end = datetime.strptime(
            date_till,
            DATE_FORMAT
        )

    except ValueError:
        raise ValueError(
            f"Invalid TILL date '{date_till}'. "
            "Use YYYY-MM-DD."
        )

    if start > end:
        raise ValueError(
            "FROM date cannot be later than TILL date."
        )

    return start, end


# ============================================================
# SERVICENOW ENCODED QUERY
# ============================================================

def build_encoded_query(
        group,
        keyword,
        start,
        end
):

    """
    Example:

    group:
        cpi-ls-incident-reg-l2

    keyword:
        Reg Asia

    from:
        2026-09-01

    till:
        2026-09-30

    Query logically represents:

        assignment_group = cpi-ls-incident-reg-l2

        AND

        short_description contains "Reg Asia"

        AND

        sys_created_on >= 2026-09-01 00:00:00

        AND

        sys_created_on < 2026-10-01 00:00:00
    """

    start_timestamp = start.strftime(
        "%Y-%m-%d 00:00:00"
    )

    # Use the beginning of the following day as an
    # exclusive upper bound.
    #
    # This includes ALL incidents created during the
    # user's TILL date.

    next_day = end + timedelta(days=1)

    end_timestamp = next_day.strftime(
        "%Y-%m-%d 00:00:00"
    )

    query = (
        f"assignment_group={group}"
        f"^short_descriptionLIKE{keyword}"
        f"^sys_created_on>={start_timestamp}"
        f"^sys_created_on<{end_timestamp}"
    )

    return query


# ============================================================
# SOAP BODY
# ============================================================

def build_soap_body(encoded_query):

    safe_query = escape(encoded_query)

    body = f"""
<SOAP-Env:Body>

    <getRecords
        xmlns="http://www.service-now.com/ticket">

        <__use_view>API</__use_view>

        <__encoded_query>{safe_query}</__encoded_query>

    </getRecords>

</SOAP-Env:Body>
"""

    return body.strip()


# ============================================================
# SOAP ENVELOPE
# ============================================================

def build_soap_request(encoded_query):

    body = build_soap_body(encoded_query)

    soap_xml = f"""<?xml version="1.0" encoding="UTF-8"?>

<SOAP-Env:Envelope
    xmlns:SOAP-Env="http://schemas.xmlsoap.org/soap/envelope/">

{body}

</SOAP-Env:Envelope>
"""

    return soap_xml


