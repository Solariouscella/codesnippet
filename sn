
#!/usr/bin/env bash
set -euo pipefail
umask 077

# Usage: ./remove_legal_party_id.sh INPUT [OUTPUT]

if (( $# < 1 || $# > 2 )); then
    printf 'Usage: %s INPUT [OUTPUT]\n' "$0" >&2
    exit 64
fi

input=$1
output=${2:-"${input}.without_legal_party_id"}

# Handle filenames beginning with a dash.
case $input in -*) input="./$input" ;; esac
case $output in -*) output="./$output" ;; esac

# Validate input.
if [[ ! -f $input || ! -r $input ]]; then
    echo "ERROR: Input is not a readable file: $input" >&2
    exit 1
fi

# Never overwrite an existing output.
if [[ $input == "$output" ]]; then
    echo "ERROR: Input and output must differ" >&2
    exit 1
fi

if [[ -e $output || -L $output ]]; then
    echo "ERROR: Output already exists: $output" >&2
    exit 1
fi

# Work in a temporary file first.
tmp=$(mktemp "${output}.tmp.XXXXXXXX")
trap 'rm -f -- "$tmp"' EXIT

LC_ALL=C awk -F '|' -v target='Legal Party ID' '

function fail(message) {
    printf "ERROR at record %d: %s\n", NR, message \
        > "/dev/stderr"
    exit 2
}

{
    # Preserve original LF/CRLF line endings.
    cr = ""
    if (sub(/\r$/, "", $0))
        cr = "\r"

    # STEP 1: Identify the target column.
    if (NR == 1) {
        expected_fields = NF
        line_ending = cr
        matches = 0

        for (i = 1; i <= NF; i++) {
            if ($i == target) {
                column = i
                matches++
            }
        }

        if (matches != 1)
            fail("Expected exactly one Legal Party ID column")

        if (NF < 2)
            fail("Cannot remove the only column")
    }
    else if (cr != line_ending) {
        fail("Mixed LF and CRLF line endings")
    }

    # STEP 2: Validate field count on every record.
    if (NF != expected_fields)
        fail(sprintf(
            "Expected %d fields, found %d",
            expected_fields, NF
        ))

    # STEP 3: Calculate the target field position.
    start = 1

    for (i = 1; i < column; i++)
        start += length($i) + 1

    # STEP 4: Remove the column.
    if (column < NF) {

        # Keep everything before the target.
        left = substr($0, 1, start - 1)

        # Skip the target and its following pipe.
        right = substr(
            $0,
            start + length($(column)) + 1
        )
    }
    else {
        # Final column: remove preceding pipe.
        left = substr($0, 1, start - 2)
        right = ""
    }

    # STEP 5: Write the reconstructed record.
    printf "%s%s%s\n", left, right, cr
}

END {
    if (NR == 0) {
        print "ERROR: Input file is empty" > "/dev/stderr"
        exit 2
    }
}

' "$input" > "$tmp"

# Publish only after successful processing.
# Hard-link creation is atomic and does not overwrite.
if ! ln -- "$tmp" "$output"; then
    echo "ERROR: Could not safely publish $output" >&2
    exit 1
fi

rm -- "$tmp"
trap - EXIT

printf 'Success: %s -> %s\n' "$input" "$output"
