# ============================================================
# XML RESPONSE PARSER
# ============================================================

def find_records(obj):

    """
    Recursively locate record-like dictionaries in the SOAP
    response.

    We only accept dictionaries containing a ticket number.
    """

    records = []

    if isinstance(obj, dict):

        if "number" in obj:
            records.append(obj)

        for value in obj.values():
            records.extend(
                find_records(value)
            )

    elif isinstance(obj, list):

        for item in obj:
            records.extend(
                find_records(item)
            )

    return records


def parse_response(xml_response):

    parsed = xmltodict.parse(xml_response)

    raw_records = find_records(parsed)

    incidents = []

    for record in raw_records:

        number = record.get(
            "number",
            ""
        )

        created = record.get(
            "sys_created_on",
            ""
        )

        short_description = record.get(
            "short_description",
            ""
        )

        incidents.append(
            {
                "number": number,
                "created": created,
                "short_description": short_description
            }
        )

    return incidents


# ============================================================
# CASE-INSENSITIVE SAFETY FILTER
# ============================================================

def filter_description(
        incidents,
        keyword
):

    """

    Server query already contains:

        short_description LIKE keyword

    This performs an additional client-side
    case-insensitive validation.

    Example keyword:

        Reg Asia

    Matches:

        Reg Asia
        REG ASIA
        reg asia
        rEg AsIa
    """

    keyword = keyword.casefold()

    results = []

    for incident in incidents:

        description = str(
            incident.get(
                "short_description",
                ""
            )
        )

        if keyword in description.casefold():
            results.append(incident)

    return results


# ============================================================
# DISPLAY RESULTS
# ============================================================

def display_results(incidents):

    print()
    print("=" * 100)
    print(
        f"{'INCIDENT':<18}"
        f"{'CREATED':<22}"
        f"SHORT DESCRIPTION"
    )
    print("=" * 100)

    if not incidents:

        print("No matching incidents found.")
        return

    for incident in incidents:

        number = incident.get(
            "number",
            ""
        )

        created = incident.get(
            "created",
            ""
        )

        description = incident.get(
            "short_description",
            ""
        )

        print(
            f"{number:<18}"
            f"{created:<22}"
            f"{description}"
        )

    print("-" * 100)

    print(
        f"Total matching incidents: "
        f"{len(incidents)}"
    )


# ============================================================
# MAIN
# ============================================================

def main():

    try:

        # ----------------------------------------------------
        # 1. User input
        # ----------------------------------------------------

        group, keyword, date_from, date_till = (
            get_inputs()
        )

        # ----------------------------------------------------
        # 2. Validate dates
        # ----------------------------------------------------

        start, end = validate_dates(
            date_from,
            date_till
        )

        # ----------------------------------------------------
        # 3. Construct query
        # ----------------------------------------------------

        encoded_query = build_encoded_query(
            group,
            keyword,
            start,
            end
        )

        print()
        print("Encoded query:")
        print(encoded_query)

        # ----------------------------------------------------
        # 4. Construct SOAP XML
        # ----------------------------------------------------

        soap_request = build_soap_request(
            encoded_query
        )

        print()
        print("SOAP request generated successfully.")

        # ----------------------------------------------------
        # 5. Send request
        # ----------------------------------------------------

        xml_response = send_soap_request(
            soap_request
        )

        # ----------------------------------------------------
        # 6. Parse SOAP response
        # ----------------------------------------------------

        incidents = parse_response(
            xml_response
        )

        # ----------------------------------------------------
        # 7. Enforce case-insensitive contains
        # ----------------------------------------------------

        incidents = filter_description(
            incidents,
            keyword
        )

        # ----------------------------------------------------
        # 8. Display
        # ----------------------------------------------------

        display_results(
            incidents
        )

    except KeyboardInterrupt:

        print("\nCancelled.")

        sys.exit(130)

    except Exception as error:

        print()
        print(f"ERROR: {error}")

        sys.exit(1)


if __name__ == "__main__":
    main()
