#!/bin/bash

select_option() {
    local options=("$@")
    local selected=0
    local key

    while true; do
        clear
        for i in "${!options[@]}"; do
            if [[ $i -eq $selected ]]; then
                echo "> ${options[$i]}"
            else
                echo "  ${options[$i]}"
            fi
        done

        read -rsn1 key
        if [[ $key == "" ]]; then
            break
        elif [[ $key == "k" ]]; then
            ((selected--))
            [[ $selected -lt 0 ]] && selected=$((${#options[@]}-1))
        elif [[ $key == "j" ]]; then
            ((selected++))
            [[ $selected -ge ${#options[@]} ]] && selected=0
        elif [[ $key == $'\x1b' ]]; then
            read -rsn2 key
            if [[ $key == "[A" ]]; then
                ((selected--))
                [[ $selected -lt 0 ]] && selected=$((${#options[@]}-1))
            elif [[ $key == "[B" ]]; then
                ((selected++))
                [[ $selected -ge ${#options[@]} ]] && selected=0
            fi
        fi
    done
    echo "${options[$selected]}"
}

echo "=== EZSSH Wrapper ==="
read -p "Hostname (or 'exit'): " HOSTNAME
[[ "$HOSTNAME" == "exit" ]] && exit 0

read -p "Impersonate user (or 'exit'): " IMPUSER
[[ "$IMPUSER" == "exit" ]] && exit 0

read -p "Ticket number -T (or 'exit'): " TICKET
[[ "$TICKET" == "exit" ]] && exit 0

while true; do
    echo ""
    echo "Run a command or a script? (j/k or arrows, Enter to select)"
    TYPE=$(select_option "command" "script" "exit")
    [[ "$TYPE" == "exit" ]] && break

    if [[ "$TYPE" == "command" ]]; then
        read -p "Enter command (or 'exit'): " CMD
        [[ "$CMD" == "exit" ]] && break
        OFLAG="$CMD"
    else
        read -p "Enter script path (or 'exit'): " SCRIPTPATH
        [[ "$SCRIPTPATH" == "exit" ]] && break
        OFLAG="script $SCRIPTPATH"
    fi

    FULL_CMD="ezssh $HOSTNAME $IMPUSER/cmd exec -T $TICKET -O \"$OFLAG\""

    echo ""
    echo "---- Dry run preview ----"
    echo "$FULL_CMD"
    echo "--------------------------"

    echo "Run this now?"
    CONFIRM=$(select_option "yes" "no")
    [[ "$CONFIRM" == "yes" ]] && eval "$FULL_CMD"

    echo ""
    echo "Run another?"
    AGAIN=$(select_option "yes" "no" "exit")
    [[ "$AGAIN" != "yes" ]] && break
done

echo "Done."