#!/usr/bin/env bash
# Verify that a cleaned pipe-delimited feed differs from the original
# ONLY by removal of its "Legal Party ID" column.
# Requires: bash, awk, GNU cut, cmp

verify_legal_party_id_removed() {
    if (( $# != 2 )); then
        printf 'Usage: verify_legal_party_id_removed ORIGINAL CLEANED\n' >&2
        return 2
    fi

    local original=$1 cleaned=$2 column
    case $original in -*) original="./$original" ;; esac
    case $cleaned in -*) cleaned="./$cleaned" ;; esac

    if [[ ! -f $original || ! -r $original || ! -f $cleaned || ! -r $cleaned ]]; then
        printf 'FAIL: Both files must exist and be readable.\n' >&2
        return 2
    fi

    # Detect the target column from the original header (not a hard-coded index).
    column=$(LC_ALL=C awk -F '[|]' '
        NR == 1 {
            hits = 0
            for (i = 1; i <= NF; i++) {
                header = $i
                sub(/\r$/, "", header)
                if (header == "Legal Party ID") { hits++; position = i }
            }
            if (hits != 1) {
                print "FAIL: Expected exactly one Legal Party ID header" > "/dev/stderr"
                exit 1
            }
            if (NF < 2) {
                print "FAIL: Cannot remove the only column" > "/dev/stderr"
                exit 1
            }
            print position
            exit
        }
        END {
            if (NR == 0) {
                print "FAIL: Original feed is empty" > "/dev/stderr"
                exit 1
            }
        }
    ' "$original") || return 1

    # Reject inconsistent records before comparing; cut alone will not detect them.
    LC_ALL=C awk -F '[|]' '
        NR == 1 { expected = NF }
        NF != expected {
            printf "FAIL: Original record %d has %d fields (expected %d)\n", NR, NF, expected > "/dev/stderr"
            bad = 1
            exit 1
        }
        END { if (bad) exit 1 }
    ' "$original" || return 1

    # Independent byte-for-byte comparison of expected result against cleaned feed.
    # Subshell enables pipefail even if this function is sourced from another script.
    if ( set -o pipefail; LC_ALL=C cut -d '|' --complement -f "$column" -- "$original" | cmp -s -- - "$cleaned" ); then
        printf 'PASS: Only Legal Party ID (column %s) was removed.\n' "$column"
        printf 'PASS: All other values, separators, records and ordering match exactly.\n'
    else
        printf 'FAIL: Cleaned file differs beyond removing Legal Party ID (column %s).\n' "$column" >&2
        return 1
    fi
}

# Run as a command, or source it to use the function in another script.
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
    verify_legal_party_id_removed "$@"
fi

